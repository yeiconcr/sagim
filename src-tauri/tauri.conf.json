{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAGIM",
  "version": "1.0.7",
  "identifier": "com.sagim.gimnasio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAGIM - Sistema Administrativo de Gimnasios",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; frame-src 'self' blob:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "SAGIM 2024",
    "category": "Business",
    "shortDescription": "Sistema Administrativo de Gimnasios",
    "longDescription": "Sistema completo de administracion para gimnasios."
  }
}
